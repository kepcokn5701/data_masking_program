# PyInstaller 빌드 산출물
build/
dist/
*.spec

# 실행 파일
*.exe

# 업무망 반입본(exe·zip 등 배포 산출물) — 용량이 커서 깃허브에 올리지 않는다.
# 필요하면 로컬 브랜치 '반입본_260728' 에 보관된 것을 쓴다.
업무망_반입본/

# Python
__pycache__/
*.pyc
*.pyo

# 사용 이력 로그 (파일명 등 메타데이터 포함 → 깃에 올리지 않음)
web/logs/

# 대용량 참고 원문(국정원 N2SF 가이드라인 PDF) — 로컬 보관·깃 제외(공개문서·약 25MB)
*.pdf

# 임시 테스트 스크립트
_test_*.py

# 설치파일 산출물 / 감시폴더(런타임 생성)
installer_output/
마스킹_감시폴더/
자동_마스킹_폴더/

# 런타임 감사로그(사용자·PC명·파일명 등 메타데이터) — 깃 제외
감사로그/

# 사용자가 직접 정한 '항상 마스킹할 칸' 규칙 — PC마다 다르므로 깃 제외
masking_rules.json

# 엑셀이 파일을 열어둘 때 만드는 임시 잠금파일
~$*

# ── 사내 실제 화면 캡처(내부 파일명·시스템 UI 노출) — 공개 저장소 제외 ──
(업무망) 데이터 사전작업(DRM 해제).png
*DRM 해제*.png
manual_assets_static.py
manual_assets_shots.py
스크린샷/
# 위 캡처가 임베드된 생성물(재생성 가능) — 깃 제외
docs/사용설명서.html
사용설명서.html
# 최초 실행 안내를 이미 띄웠는지 기억하는 표시 파일(런타임 생성)
최초실행안내완료.txt

# 임시/IDE
.vscode/
.idea/
.claude/
*.swp
*.log
